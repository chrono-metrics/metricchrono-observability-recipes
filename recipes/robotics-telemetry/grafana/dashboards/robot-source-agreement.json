          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (metricchrono_robot_tracking_error_distance_bucket{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",le=~\".*\"}))",
          "legendFormat": "p50 tracking error",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (metricchrono_robot_tracking_error_distance_bucket{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",le=~\".*\"}))",
          "legendFormat": "p95 tracking error",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Tracking Error Distribution",
      "type": "timeseries"
