          "editorMode": "code",
          "expr": "max by (asset) (metricchrono_robot_motor_temperature_change_score{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",source=~\"$source\"})",
          "legendFormat": "{{asset}} temperature",
          "range": true,
