{
  "name": "metricchrono-observability-recipes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "mlops:generate": "python3 scripts/generate_assets.py",
    "mlops:capture": "python3 scripts/capture_grafana_screenshots.py",
    "mlops:serve": "python3 scripts/serve_metrics.py",
    "mlops:start": "python3 scripts/start_local_stack.py",
    "mlops:stop": "python3 scripts/stop_local_stack.py",
    "mlops:validate": "python3 scripts/validate_recipe.py",
    "mlops:live": "python3 scripts/live_grafana_check.py",
    "mlops:test": "python3 scripts/smoke_mlops_adapter.py && python3 scripts/smoke_alert_windows.py && python3 -m unittest discover -s tests",
    "mlops:smoke:python": "python3 recipes/mlops/examples/python/metricchrono_smoke.py",
    "mlops:smoke:js": "node recipes/mlops/examples/js/metricchrono-smoke.mjs",
    "mlops:check:prometheus": "promtool check config recipes/mlops/prometheus/prometheus.yml && promtool check rules recipes/mlops/rules/metricchrono_recipe_alerts.yml",
    "robotics:generate": "python3 scripts/generate_domain_recipes.py --recipe robotics",
    "robotics:capture": "python3 scripts/capture_domain_grafana_screenshots.py --recipe robotics",
    "robotics:serve": "python3 scripts/serve_domain_metrics.py --recipe robotics",
    "robotics:start": "python3 scripts/start_domain_stack.py --recipe robotics",
    "robotics:stop": "python3 scripts/stop_domain_stack.py --recipe robotics",
    "robotics:validate": "python3 scripts/validate_domain_recipes.py --recipe robotics",
    "industrial:generate": "python3 scripts/generate_domain_recipes.py --recipe industrial",
    "industrial:capture": "python3 scripts/capture_domain_grafana_screenshots.py --recipe industrial",
    "industrial:serve": "python3 scripts/serve_domain_metrics.py --recipe industrial",
    "industrial:start": "python3 scripts/start_domain_stack.py --recipe industrial",
    "industrial:stop": "python3 scripts/stop_domain_stack.py --recipe industrial",
    "industrial:validate": "python3 scripts/validate_domain_recipes.py --recipe industrial",
    "telemetry:generate": "python3 scripts/generate_domain_recipes.py --recipe all",
    "telemetry:capture": "python3 scripts/capture_domain_grafana_screenshots.py --recipe telemetry",
    "telemetry:serve": "python3 scripts/serve_domain_metrics.py --recipe telemetry",
    "telemetry:start": "python3 scripts/start_domain_stack.py --recipe telemetry",
    "telemetry:stop": "python3 scripts/stop_domain_stack.py --recipe telemetry",
    "telemetry:validate": "python3 scripts/validate_domain_recipes.py --recipe telemetry",
    "rust:check": "cargo check",
    "validate:recipes": "npm run mlops:validate && npm run telemetry:validate",
    "validate": "npm run validate:recipes && npm run mlops:test && npm run mlops:smoke:js",
    "validate:ci": "npm run validate && npm run mlops:check:prometheus && npm run rust:check && npm run mlops:smoke:python"
  },
  "dependencies": {
    "@metricchrono/core": "0.1.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
