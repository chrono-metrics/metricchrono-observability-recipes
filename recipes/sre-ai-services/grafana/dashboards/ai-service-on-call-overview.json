    {
      "title": "Are AI dependencies healthy?",
      "type": "timeseries",
      "description": "What this shows:\nProvider latency, provider errors, rate limits, token usage, retrieval latency, tool latency, and cache hit ratio.\n\nWhy you care:\nAI incidents often originate in hosted models, vector stores, retrievers, tools, or cache paths.\n\nHow to read it:\nCompare dependency p95 against service p95 and provider errors against local errors; dependency degradation leading service degradation routes away from app debugging.\n\nWhat to do next:\nUse the provider dependency runbook if provider or retrieval signals lead the incident.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metricchrono_sre_ai_provider_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",provider=~\".*\"}[2m])))",
          "legendFormat": "provider p95",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(metricchrono_sre_ai_provider_errors_total{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",provider=~\".*\"}[2m]))",
          "legendFormat": "{{provider}} errors",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (provider) (rate(metricchrono_sre_ai_provider_rate_limits_total{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",provider=~\".*\"}[2m]))",
          "legendFormat": "{{provider}} rate limits",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metricchrono_sre_ai_retrieval_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",dependency=\"retriever\"}[2m])))",
          "legendFormat": "retrieval p95",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metricchrono_sre_ai_tool_call_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",dependency=\"tool_api\"}[2m])))",
          "legendFormat": "tool p95",
          "refId": "E",
