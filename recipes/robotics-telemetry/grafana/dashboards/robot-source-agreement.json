    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Question answered: What did the robot itself report?\n\nHow to read it: Rows summarize bounded diagnostic categories, not raw free-form messages.\n\nWhy it matters: The robot's own diagnostics may already identify the issue. Change metrics should support, not obscure, that signal.\n\nNext action: Use diagnostic category as the primary investigation path if it aligns with change score.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
