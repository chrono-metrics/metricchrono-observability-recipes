          "editorMode": "code",
          "expr": "metricchrono_robot_perception_confidence_change_score{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",comparison=\"sensor_vs_estimator\"}",
          "legendFormat": "{{asset}} confidence change",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Perception Source Change",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Question answered: Did the source actually publish on time?\n\nHow to read it: Freshness increasing means the source is stale. Missing and late counters rising mean data availability changed.\n\nWhy it matters: Robotics systems are sensitive to stale perception, stale transforms, and delayed actuator feedback.\n\nNext action: Inspect middleware, CPU, network, driver frequency, and timestamp handling.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
