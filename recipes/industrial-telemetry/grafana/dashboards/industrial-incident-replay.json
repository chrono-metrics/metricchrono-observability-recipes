          "text": "vibration_sensor|motor_current|pressure|quality_proxy|temperature",
          "value": "vibration_sensor|motor_current|pressure|quality_proxy|temperature"
        },
        "name": "source",
        "query": "vibration_sensor|motor_current|pressure|quality_proxy|temperature",
        "type": "textbox"
      },
      {
        "current": {
          "text": "known_good_baseline",
          "value": "known_good_baseline"
        },
        "name": "comparison",
        "query": "known_good_baseline",
        "type": "textbox"
      },
      {
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "name": "change_size",
        "query": ".*",
        "type": "textbox"
      }
    ]
  },
  "time": {
    "from": "now-2m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Industrial Incident Replay",
  "uid": "industrial-incident-replay",
  "version": 1
}
