    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Question answered: Is the controller asking for one thing while the robot does another?\n\nHow to read it: Divergence between commanded and actual velocity indicates tracking failure, slip, saturation, load, or controller instability.\n\nWhy it matters: This is the simplest control-language explanation of a behavior change.\n\nNext action: Inspect motor current, effort, wheel slip, actuator saturation, terrain, and safety limits.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
