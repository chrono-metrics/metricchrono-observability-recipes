    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Question answered: Is tracking error a one-off spike or a changed distribution?\n\nHow to read it: A shifted distribution means persistent behavior change. A single spike means a transient event.\n\nWhy it matters: Robotics engineers need to distinguish one bad moment from a new operating condition.\n\nNext action: If the distribution shifts, inspect calibration, controller parameters, payload, terrain, and hardware wear.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
