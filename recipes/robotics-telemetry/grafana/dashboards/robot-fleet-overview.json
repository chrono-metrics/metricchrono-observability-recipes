          "editorMode": "code",
          "expr": "max by (asset) (metricchrono_robot_actuator_effort_change_score{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",source=~\"$source\"})",
          "legendFormat": "{{asset}} effort",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "max by (asset) (metricchrono_robot_motor_current_change_score{site=\"$site\",environment=\"$environment\",recipe=\"robotics-telemetry\",asset_group=~\"$asset_group\",asset=~\"$asset\",source=~\"$source\"})",
          "legendFormat": "{{asset}} current",
          "range": true,
