{
  "description": "",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nCompared to last window shows sudden jumps. Compared to baseline shows accumulated drift from normal behavior.\n\nWhy you care:\nSudden changes suggest rollout or config incidents. Gradual changes suggest data or population drift.\n\nHow to read it:\nSudden change spikes during Model Change. Drift from normal rises through Gradual Data Drift.\n\nWhat to do next:\nUse the deploy and subsystem panels to pick the next path.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_behavior_change_score"
        ],
        "tableColumns": [],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(metricchrono_ai_behavior_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"last_window\"})",
          "format": "time_series",
          "legendFormat": "Sudden change",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(metricchrono_ai_behavior_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"})",
          "format": "time_series",
          "legendFormat": "Drift from normal",
          "refId": "B"
        }
      ],
      "title": "Was the change sudden or gradual?",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nRanks the parts of the AI pipeline by how much they changed.\n\nWhy you care:\nThis turns a generic behavior signal into an investigation path.\n\nHow to read it:\nThe tallest bar is the subsystem to inspect first.\n\nWhat to do next:\nUse the table below to pick a stream and next step.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_agent_workflow_change_score",
          "metricchrono_ai_embedding_change_score",
          "metricchrono_ai_input_change_score",
          "metricchrono_ai_output_change_score",
          "metricchrono_ai_retrieval_change_score"
        ],
        "tableColumns": [],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(max_over_time(metricchrono_ai_input_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Inputs",
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(max_over_time(metricchrono_ai_embedding_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Embeddings",
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(max_over_time(metricchrono_ai_output_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Outputs",
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(max_over_time(metricchrono_ai_retrieval_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Retrieval",
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(max_over_time(metricchrono_ai_agent_workflow_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Agent workflow",
          "range": false,
          "refId": "E"
        }
      ],
      "title": "Which part of the AI system changed?",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nDistribution of current behavior differences from normal behavior.\n\nWhy you care:\nA distribution shift is more credible than one isolated spike.\n\nHow to read it:\nBuckets moving right indicate broader behavior movement.\n\nWhat to do next:\nIf the distribution shifts, inspect the highest-ranked stream.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_behavior_distance"
        ],
        "tableColumns": [],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (le) (rate(metricchrono_ai_behavior_distance_bucket{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=\"normal_baseline\"}[$window]))",
          "format": "time_series",
          "legendFormat": "Behavior distance",
          "refId": "A"
        }
      ],
      "title": "How different is current traffic from normal?",
      "type": "histogram"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nHow long the service stayed in Normal, Watch, Drift, or Incident state.\n\nWhy you care:\nPersistence changes urgency.\n\nHow to read it:\nShort-lived Watch is less urgent than sustained Drift or Incident.\n\nWhat to do next:\nIf Drift persists, follow the suggested next step table.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_drift_state"
        ],
        "tableColumns": [],
        "unitMarking": "none"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(metricchrono_ai_drift_state{service=\"$service\",environment=\"$environment\",model=\"$model\",stream=\"overall.behavior\"})",
          "format": "time_series",
          "legendFormat": "Behavior state",
          "refId": "A"
        }
      ],
      "title": "How long has this been happening?",
      "type": "state-timeline"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nBehavior movement grouped by model version.\n\nWhy you care:\nMLOps teams compare versions during rollout and rollback decisions.\n\nHow to read it:\nThe higher version is the one to inspect first.\n\nWhat to do next:\nIf v2 is higher, inspect deploy diffs and output behavior.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_behavior_change_score"
        ],
        "tableColumns": [],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (model_version) (max_over_time(metricchrono_ai_behavior_change_score{service=\"$service\",environment=\"$environment\",model=\"$model\",comparison=~\"normal_baseline|previous_model_version\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{model_version}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Which model version changed behavior most?",
      "type": "barchart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nRanked inspection candidates with likely cause and next action.\n\nWhy you care:\nThis turns monitoring into triage.\n\nHow to read it:\nStart with rank 1, then follow the suggested next step.\n\nWhat to do next:\nUse the optional workload dashboards when the top row points to retrieval, agent workflow, or source agreement.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "id": 6,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_inspection_candidate"
        ],
        "tableColumns": [
          "rank",
          "time",
          "service",
          "stream",
          "model_version",
          "main_change",
          "change_score",
          "cause",
          "next_step"
        ],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, max by (rank,service,stream,workload,model_version,main_change,cause,next_step,drift_state) (max_over_time(metricchrono_ai_inspection_candidate{service=\"$service\",environment=\"$environment\",model=\"$model\"}[$__range])))",
          "format": "table",
          "instant": true,
          "legendFormat": "candidate",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "What should I inspect first?",
      "type": "table"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nHow old the normal reference is.\n\nWhy you care:\nOld baselines can make drift scores harder to trust.\n\nHow to read it:\nThe demo baseline age is bounded and visible.\n\nWhat to do next:\nRefresh or review the baseline if this is unexpectedly old.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "id": 7,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_baseline_age_seconds"
        ],
        "tableColumns": [],
        "unitMarking": "s"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(metricchrono_ai_baseline_age_seconds{service=\"$service\",environment=\"$environment\",model=\"$model\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "Baseline age",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Is the baseline stale?",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "What this shows:\nRecent movement summarized as small, medium, and large.\n\nWhy you care:\nThis helps decide whether to page someone or keep watching.\n\nHow to read it:\nSmall dominates in noise. Large rises during a meaningful shift.\n\nWhat to do next:\nIf large is elevated, inspect deploys and changed streams.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 16,
            "showPoints": "never"
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "id": 8,
      "mcRecipe": {
        "expectedMetrics": [
          "metricchrono_ai_change_score_by_size"
        ],
        "tableColumns": [],
        "unitMarking": "percent"
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (change_size) (max_over_time(metricchrono_ai_change_score_by_size{service=\"$service\",environment=\"$environment\",model=\"$model\",stream=\"overall.behavior\",change_size=~\"$change_size\"}[$__range]))",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{change_size}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Was this only small noise?",
      "type": "bargauge"
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": [
    "ai-observability",
    "mlops",
    "metricchrono",
    "recipe"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 0,
        "name": "datasource",
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "text": "checkout-ai",
          "value": "checkout-ai"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "service",
        "query": "label_values(metricchrono_ai_behavior_change_score, service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "local",
          "value": "local"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "environment",
        "query": "label_values(metricchrono_ai_behavior_change_score, environment)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "recommendation-ranker",
          "value": "recommendation-ranker"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "model",
        "query": "label_values(metricchrono_ai_behavior_change_score, model)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "v2",
          "value": "v2"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "model_version",
        "query": "label_values(metricchrono_ai_behavior_change_score, model_version)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "model_service",
          "value": "model_service"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "workload",
        "query": "label_values(metricchrono_ai_behavior_change_score, workload)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "overall.behavior",
          "value": "overall.behavior"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "stream",
        "query": "label_values(metricchrono_ai_behavior_change_score, stream)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": {
          "text": "normal_baseline",
          "value": "normal_baseline"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "hide": 0,
        "name": "comparison",
        "query": "label_values(metricchrono_ai_behavior_change_score, comparison)",
        "refresh": 1,
        "type": "query"
      },
      {
        "allValue": "small|medium|large",
        "current": {
          "text": "small|medium|large",
          "value": "small|medium|large"
        },
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "change_size",
        "query": "small,medium,large",
        "type": "custom"
      },
      {
        "current": {
          "text": "30s",
          "value": "30s"
        },
        "hide": 0,
        "name": "window",
        "query": "30s,1m,2m,5m",
        "type": "custom"
      }
    ]
  },
  "time": {
    "from": "now-2m",
    "to": "now"
  },
  "timezone": "browser",
  "title": "Drift Investigation",
  "uid": "drift-investigation",
  "version": 1
}
