    {
      "title": "Post-rollback recovery",
      "type": "timeseries",
      "description": "What this shows:\nActive version, SLO burn, latency, error rate, behavior-change, and quality proxy after rollback.\n\nWhy you care:\nSREs need verification, not just a rollback event.\n\nHow to read it:\nCompare pre-rollback to post-rollback; if service health recovers but behavior remains changed, rollback may have fixed infrastructure but not AI behavior.\n\nWhat to do next:\nKeep watching until all configured recovery conditions are below thresholds.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "metricchrono_sre_ai_model_version_active{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",active_model_version=~\".*\"}",
          "legendFormat": "model {{active_model_version}} active",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "metricchrono_sre_ai_slo_burn_rate{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",window=\"short\"}",
          "legendFormat": "{{traffic_role}} short burn",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(metricchrono_sre_ai_request_duration_seconds_bucket{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\",outcome=\"success\"}[2m])))",
          "legendFormat": "success p95",
          "refId": "C",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (service) (rate(metricchrono_sre_ai_errors_total{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\"}[2m]))",
          "legendFormat": "error rate",
          "refId": "D",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "metricchrono_sre_ai_behavior_change_score{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\"}",
          "legendFormat": "{{traffic_role}} behavior",
          "refId": "E",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "metricchrono_sre_ai_quality_proxy{service=~\"$service\",environment=~\"$environment\",model=~\"$model\",model_version=~\"$model_version\",workload=~\"$workload\",stream=~\"$stream\",traffic_role=~\"$traffic_role\"}",
          "legendFormat": "{{traffic_role}} quality",
          "refId": "F",
          "range": true
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      }
    }
  ],
